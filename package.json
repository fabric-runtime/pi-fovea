{
  "name": "pi-fovea",
  "version": "0.33.0",
  "description": "Token-budgeted repo mapping for agent sessions: foveated heat diffusion over a cross-language code graph, with progressive disclosure.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "author": "monotykamary",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fabric-runtime/pi-fovea.git"
  },
  "homepage": "https://github.com/fabric-runtime/pi-fovea#readme",
  "bugs": "https://github.com/fabric-runtime/pi-fovea/issues",
  "keywords": [
    "pi-package",
    "pi-extension",
    "repo-map",
    "code-graph",
    "heat-diffusion",
    "progressive-disclosure",
    "context-engineering",
    "agents"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ],
    "skills": [
      "./skills"
    ],
    "image": "https://raw.githubusercontent.com/fabric-runtime/pi-fovea/main/media/cover.svg"
  },
  "exports": {
    "./ops": "./src/core/ops.ts",
    "./substrate": "./src/substrate.ts",
    "./workspace": "./src/workspace.ts"
  },
  "files": [
    "src",
    "docs/substrate.md",
    "docs/exact-heat.md",
    "docs/workspace.md",
    "docs/proofs.md",
    "docs/cli.md",
    "docs/releasing.md",
    "docs/licenses/gdp-wired-mit.txt",
    "THIRD_PARTY_NOTICES.md",
    "proofs",
    "scripts/check-proofs.ts",
    "scripts/check-lean.ts",
    "scripts/compile-gdp.ts",
    "scripts/parse-source.ts",
    "scripts/check-streams.ts",
    "scripts/check-series.ts",
    "scripts/check-completion.ts",
    "scripts/check-residual.ts",
    "scripts/check-operator-identity.ts",
    "scripts/check-operators.ts",
    "scripts/check-transport.ts",
    "scripts/check-focus.ts",
    "scripts/check-enclosures.ts",
    "scripts/check-normalization.ts",
    "scripts/check-ports.ts",
    "scripts/prove-polynomial.ts",
    "cli.ts",
    "dist/cli.mjs",
    "skills",
    "media",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "fovea": "dist/cli.mjs"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "bench": "tsx scripts/bench.ts",
    "corpus:coverage": "bun scripts/coverage-corpus.mjs",
    "corpus:performance": "bun scripts/performance-corpus.mjs",
    "build:cli": "bun run proofs:artifact && tsx scripts/build-cli.ts",
    "prepack": "bun run check:proofs && bun run build:cli",
    "check:package": "node scripts/check-package.mjs",
    "pack:cli": "node scripts/pack-cli.mjs",
    "check:package:cli": "node scripts/check-package.mjs --cli",
    "fovea": "tsx cli.ts",
    "lint:dead": "knip",
    "check:proofs": "tsx scripts/check-proofs.ts",
    "check:streams": "tsx scripts/check-streams.ts",
    "check:series": "tsx scripts/check-series.ts",
    "check:completion": "tsx scripts/check-completion.ts",
    "check:residual": "tsx scripts/check-residual.ts",
    "check:operator-identity": "tsx scripts/check-operator-identity.ts",
    "check:operators": "tsx scripts/check-operators.ts",
    "check:transport": "tsx scripts/check-transport.ts",
    "check:focus": "tsx scripts/check-focus.ts",
    "check:enclosures": "tsx scripts/check-enclosures.ts",
    "check:normalization": "tsx scripts/check-normalization.ts",
    "check:ports": "tsx scripts/check-ports.ts",
    "check:lean": "tsx scripts/check-lean.ts",
    "check:lean:artifact": "tsx scripts/check-lean.ts --artifact",
    "proofs:generate": "tsx scripts/check-proofs.ts --write",
    "proofs:artifact": "tsx scripts/check-proofs.ts --artifact",
    "check:fast": "bun run check:proofs && bun run typecheck && bun run test:changed",
    "test:changed": "node scripts/test-affected.mjs",
    "test:affected": "node scripts/test-affected.mjs --base $PI_TEST_BASE",
    "test:related": "vitest related",
    "test:smoke": "vitest run tests/verified-kernels.test.ts tests/startup.test.ts tests/config.test.ts tests/settings.test.ts tests/substrate.test.ts tests/scan.test.ts tests/extract.test.ts tests/join.test.ts tests/heat.test.ts tests/nuclei.test.ts tests/render.test.ts",
    "format": "prettier --write \"{src,tests,scripts,proofs}/**/*.{ts,mjs}\" \"*.ts\" \"*.json\"",
    "format:check": "prettier --check \"{src,tests,scripts,proofs}/**/*.{ts,mjs}\" \"*.ts\" \"*.json\""
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.3.0",
    "@earendil-works/pi-tui": "1.3.0",
    "@types/node": "^22.0.0",
    "esbuild": "^0.28.1",
    "gdp-wired": "0.30.1",
    "knip": "^6.32.0",
    "prettier": "3.9.10",
    "tsx": "^4.19.0",
    "typebox": "1.3.27",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  },
  "optionalDependencies": {
    "@ast-grep/cli": "^0.45.3"
  },
  "trustedDependencies": [
    "@ast-grep/cli"
  ],
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@earendil-works/pi-tui": {
      "optional": true
    }
  },
  "workspaces": [
    "."
  ]
}
